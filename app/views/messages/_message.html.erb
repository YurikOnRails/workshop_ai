<div class="message <%= 'own-message' if message.user_id == current_user.id %>" data-message-id="<%= message.id %>" id="message-<%= message.id %>">
  <div class="message-avatar">
    <img src="<%= message.user.avatar_url || asset_path('default-avatar.png') %>" alt="<%= message.user.username %>'s avatar">
  </div>
  
  <div class="message-content">
    <div class="message-header">
      <span class="message-username"><%= message.user.username %></span>
      <span class="message-time" title="<%= message.created_at.strftime('%B %d, %Y at %H:%M') %>">
        <%= time_ago_in_words(message.created_at) %> ago
      </span>
      
      <% if message.edited? %>
        <span class="message-edited" title="Edited">(edited)</span>
      <% end %>
      
      <% if message.user_id == current_user.id || current_user.admin? %>
        <div class="message-actions ml-2 opacity-0 group-hover:opacity-100 transition-opacity">
          <div class="relative inline-block text-left">
            <button type="button" class="message-action-button" id="message-actions-<%= message.id %>" aria-expanded="false" aria-haspopup="true">
              <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
              </svg>
            </button>
            
            <div id="message-dropdown-<%= message.id %>" class="hidden origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-10" role="menu" aria-orientation="vertical" tabindex="-1">
              <div class="py-1" role="none">
                <% if message.user_id == current_user.id %>
                  <button type="button" class="message-edit-button text-gray-700 block w-full text-left px-4 py-2 text-sm hover:bg-gray-100" data-message-id="<%= message.id %>">
                    <svg class="h-4 w-4 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                    Edit
                  </button>
                <% end %>
                
                <button type="button" class="message-delete-button text-red-600 block w-full text-left px-4 py-2 text-sm hover:bg-gray-100" data-message-id="<%= message.id %>">
                  <svg class="h-4 w-4 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 22H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  Delete
                </button>
                
                <button type="button" class="message-copy-button text-gray-700 block w-full text-left px-4 py-2 text-sm hover:bg-gray-100" data-message-id="<%= message.id %>">
                  <svg class="h-4 w-4 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                  </svg>
                  Copy Text
                </button>
                
                <button type="button" class="message-report-button text-gray-700 block w-full text-left px-4 py-2 text-sm hover:bg-gray-100">
                  <svg class="h-4 w-4 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  Report
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="message-text">
      <% if message.file.attached? %>
        <div class="mb-2">
          <% if message.file.image? %>
            <div class="max-w-xs rounded-lg overflow-hidden border border-gray-200">
              <%= image_tag message.file, class: 'w-full h-auto' %>
            </div>
          <% elsif message.file.video? %>
            <div class="relative pt-[56.25%] bg-black rounded-lg overflow-hidden">
              <video src="<%= rails_blob_url(message.file) %>" controls class="absolute inset-0 w-full h-full"></video>
            </div>
          <% elsif message.file.audio? %>
            <div class="p-3 bg-gray-100 rounded-lg">
              <audio src="<%= rails_blob_url(message.file) %>" controls class="w-full"></audio>
            </div>
          <% else %>
            <div class="inline-block px-4 py-2 bg-gray-100 rounded-lg">
              <div class="flex items-center">
                <svg class="h-6 w-6 text-gray-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <div>
                  <div class="font-medium text-sm"><%= message.file.filename %></div>
                  <div class="text-xs text-gray-500"><%= number_to_human_size(message.file.byte_size) %></div>
                </div>
                <a href="<%= rails_blob_url(message.file) %>" class="ml-4 text-indigo-600 hover:text-indigo-800 text-sm font-medium" download>
                  Download
                </a>
              </div>
            </div>
          <% end %>
          
          <% if message.content.present? %>
            <div class="mt-2">
              <%= render_markdown(message.content) %>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render_markdown(message.content) %>
      <% end %>
      
      <% if message.reactions.any? %>
        <div class="mt-1 flex flex-wrap gap-1">
          <% message.reactions.group(:emoji).count.each do |emoji, count| %>
            <button type="button" class="message-reaction-button px-2 py-0.5 text-xs bg-gray-100 hover:bg-gray-200 rounded-full border border-transparent hover:border-gray-300" data-message-id="<%= message.id %>" data-emoji="<%= emoji %>">
              <span class="emoji"><%= emoji %></span>
              <span class="count"><%= count %></span>
            </button>
          <% end %>
          
          <button type="button" class="add-reaction-button px-2 py-0.5 text-xs text-gray-500 hover:bg-gray-100 rounded-full" data-message-id="<%= message.id %>">
            <svg class="h-3 w-3 inline-block -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle message dropdown
    const messageActionsButton = document.getElementById('message-actions-<%= message.id %>');
    const messageDropdown = document.getElementById('message-dropdown-<%= message.id %>');
    
    if (messageActionsButton && messageDropdown) {
      messageActionsButton.addEventListener('click', function(e) {
        e.stopPropagation();
        messageDropdown.classList.toggle('hidden');
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        if (!messageActionsButton.contains(e.target) && !messageDropdown.contains(e.target)) {
          messageDropdown.classList.add('hidden');
        }
      });
    }
    
    // Handle message actions
    const messageId = <%= message.id %>;
    const messageElement = document.getElementById(`message-${messageId}`);
    
    if (messageElement) {
      // Edit message
      const editButton = messageElement.querySelector('.message-edit-button');
      if (editButton) {
        editButton.addEventListener('click', function() {
          const messageText = messageElement.querySelector('.message-text').textContent.trim();
          const messageForm = `
            <form class="edit-message-form" data-remote="true" action="/messages/${messageId}" accept-charset="UTF-8" method="post">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <div class="flex items-start space-x-2">
                <div class="flex-1">
                  <textarea name="message[content]" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" rows="3" required>${messageText}</textarea>
                </div>
                <div class="flex flex-col space-y-1">
                  <button type="submit" class="inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Save
                  </button>
                  <button type="button" class="cancel-edit-message inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Cancel
                  </button>
                </div>
              </div>
            </form>
          `;
          
          messageElement.querySelector('.message-text').innerHTML = messageForm;
          
          // Focus the textarea
          const textarea = messageElement.querySelector('textarea');
          if (textarea) {
            textarea.focus();
            textarea.setSelectionRange(textarea.value.length, textarea.value.length);
          }
          
          // Handle form submission
          const form = messageElement.querySelector('.edit-message-form');
          if (form) {
            form.addEventListener('submit', function(e) {
              e.preventDefault();
              
              fetch(this.action, {
                method: 'PATCH',
                body: new FormData(this),
                headers: {
                  'X-Requested-With': 'XMLHttpRequest',
                  'Accept': 'application/json',
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                },
                credentials: 'same-origin'
              })
              .then(response => response.json())
              .then(data => {
                if (data.status === 'success') {
                  // Update the message content
                  messageElement.querySelector('.message-text').innerHTML = data.html;
                  
                  // Update the edited indicator
                  const editedSpan = messageElement.querySelector('.message-edited');
                  if (editedSpan) {
                    editedSpan.textContent = '(edited)';
                  } else {
                    const timeElement = messageElement.querySelector('.message-time');
                    if (timeElement) {
                      timeElement.insertAdjacentHTML('afterend', ' <span class="message-edited" title="Edited">(edited)</span>');
                    }
                  }
                } else {
                  alert(data.error || 'Failed to update message');
                }
              })
              .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while updating the message');
              });
            });
          }
          
          // Handle cancel button
          const cancelButton = messageElement.querySelector('.cancel-edit-message');
          if (cancelButton) {
            cancelButton.addEventListener('click', function() {
              // Restore original message
              messageElement.querySelector('.message-text').innerHTML = `
                ${messageElement.querySelector('.message-text').textContent.trim()}
                <% if message.reactions.any? %>
                  <div class="mt-1 flex flex-wrap gap-1">
                    <% message.reactions.group(:emoji).count.each do |emoji, count| %>
                      <button type="button" class="message-reaction-button px-2 py-0.5 text-xs bg-gray-100 hover:bg-gray-200 rounded-full border border-transparent hover:border-gray-300" data-message-id="<%= message.id %>" data-emoji="<%= emoji %>">
                        <span class="emoji"><%= emoji %></span>
                        <span class="count"><%= count %></span>
                      </button>
                    <% end %>
                    
                    <button type="button" class="add-reaction-button px-2 py-0.5 text-xs text-gray-500 hover:bg-gray-100 rounded-full" data-message-id="<%= message.id %>">
                      <svg class="h-3 w-3 inline-block -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                      </svg>
                    </button>
                  </div>
                <% end %>
              `;
            });
          }
        });
      }
      
      // Delete message
      const deleteButton = messageElement.querySelector('.message-delete-button');
      if (deleteButton) {
        deleteButton.addEventListener('click', function() {
          if (confirm('Are you sure you want to delete this message?')) {
            fetch(`/messages/${messageId}`, {
              method: 'DELETE',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              },
              credentials: 'same-origin'
            })
            .then(response => response.json())
            .then(data => {
              if (data.status === 'success') {
                // Remove the message element
                messageElement.remove();
              } else {
                alert(data.error || 'Failed to delete message');
              }
            })
            .catch(error => {
              console.error('Error:', error);
              alert('An error occurred while deleting the message');
            });
          }
        });
      }
      
      // Copy message text
      const copyButton = messageElement.querySelector('.message-copy-button');
      if (copyButton) {
        copyButton.addEventListener('click', function() {
          const messageText = messageElement.querySelector('.message-text').textContent.trim();
          navigator.clipboard.writeText(messageText).then(() => {
            // Show a tooltip or notification that text was copied
            const originalText = copyButton.innerHTML;
            copyButton.innerHTML = `
              <svg class="h-4 w-4 inline-block mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Copied!
            `;
            
            setTimeout(() => {
              copyButton.innerHTML = originalText;
            }, 2000);
          }).catch(err => {
            console.error('Failed to copy text: ', err);
          });
        });
      }
      
      // Add reaction
      const addReactionButton = messageElement.querySelector('.add-reaction-button');
      if (addReactionButton) {
        addReactionButton.addEventListener('click', function(e) {
          e.stopPropagation();
          
          // Create emoji picker
          const emojiPicker = document.createElement('div');
          emojiPicker.className = 'emoji-picker absolute z-10 bg-white border border-gray-200 rounded-lg shadow-lg p-2 grid grid-cols-6 gap-1';
          
          // Common emojis for quick access
          const commonEmojis = ['👍', '❤️', '😂', '😮', '😢', '😠', '👏', '🙌', '🔥', '🎉'];
          
          emojiPicker.innerHTML = `
            <div class="col-span-6 mb-2 text-xs text-gray-500">Add reaction</div>
            ${commonEmojis.map(emoji => `
              <button type="button" class="emoji-option text-xl p-1 hover:bg-gray-100 rounded" data-emoji="${emoji}">
                ${emoji}
              </button>
            `).join('')}
          `;
          
          // Position the emoji picker
          const rect = addReactionButton.getBoundingClientRect();
          emojiPicker.style.top = `${rect.top - 150}px`;
          emojiPicker.style.left = `${rect.left}px`;
          
          // Add to document
          document.body.appendChild(emojiPicker);
          
          // Handle emoji selection
          emojiPicker.querySelectorAll('.emoji-option').forEach(button => {
            button.addEventListener('click', function() {
              const emoji = this.getAttribute('data-emoji');
              
              // Send request to add reaction
              fetch(`/messages/${messageId}/reactions`, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest',
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({ emoji: emoji }),
                credentials: 'same-origin'
              })
              .then(response => response.json())
              .then(data => {
                if (data.status === 'success') {
                  // Update the UI with the new reaction
                  updateReactionsUI(messageElement, data.reactions);
                }
              })
              .catch(error => {
                console.error('Error adding reaction:', error);
              });
              
              // Remove the picker
              emojiPicker.remove();
            });
          });
          
          // Close picker when clicking outside
          const clickHandler = function(e) {
            if (!emojiPicker.contains(e.target) && e.target !== addReactionButton) {
              document.removeEventListener('click', clickHandler);
              emojiPicker.remove();
            }
          };
          
          // Use setTimeout to avoid immediate close when clicking the button
          setTimeout(() => {
            document.addEventListener('click', clickHandler);
          }, 0);
        });
      }
      
      // Handle existing reaction clicks
      messageElement.querySelectorAll('.message-reaction-button').forEach(button => {
        button.addEventListener('click', function() {
          const emoji = this.getAttribute('data-emoji');
          
          // Toggle reaction
          fetch(`/messages/${messageId}/reactions/toggle`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ emoji: emoji }),
            credentials: 'same-origin'
          })
          .then(response => response.json())
          .then(data => {
            if (data.status === 'success') {
              // Update the UI with the updated reactions
              updateReactionsUI(messageElement, data.reactions);
            }
          })
          .catch(error => {
            console.error('Error toggling reaction:', error);
          });
        });
      });
    }
    
    // Helper function to update reactions UI
    function updateReactionsUI(messageElement, reactions) {
      const reactionsContainer = messageElement.querySelector('.message-reactions');
      const addReactionButton = messageElement.querySelector('.add-reaction-button');
      
      if (reactions && Object.keys(reactions).length > 0) {
        let html = '<div class="mt-1 flex flex-wrap gap-1">';
        
        Object.entries(reactions).forEach(([emoji, count]) => {
          html += `
            <button type="button" class="message-reaction-button px-2 py-0.5 text-xs bg-gray-100 hover:bg-gray-200 rounded-full border border-transparent hover:border-gray-300" data-message-id="${messageId}" data-emoji="${emoji}">
              <span class="emoji">${emoji}</span>
              <span class="count">${count}</span>
            </button>
          `;
        });
        
        html += `
          <button type="button" class="add-reaction-button px-2 py-0.5 text-xs text-gray-500 hover:bg-gray-100 rounded-full" data-message-id="${messageId}">
            <svg class="h-3 w-3 inline-block -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </button>
        `;
        
        html += '</div>';
        
        if (reactionsContainer) {
          reactionsContainer.innerHTML = html;
        } else {
          // Create reactions container if it doesn't exist
          const container = document.createElement('div');
          container.className = 'message-reactions';
          container.innerHTML = html;
          
          const messageText = messageElement.querySelector('.message-text');
          if (messageText) {
            messageText.appendChild(container);
          }
        }
        
        // Re-attach event listeners
        attachReactionListeners(messageElement);
      } else {
        // No reactions, remove the container
        if (reactionsContainer) {
          reactionsContainer.remove();
        }
      }
    }
    
    // Helper function to attach reaction event listeners
    function attachReactionListeners(messageElement) {
      const messageId = messageElement.getAttribute('data-message-id');
      
      // Add reaction
      const addReactionButton = messageElement.querySelector('.add-reaction-button');
      if (addReactionButton) {
        addReactionButton.addEventListener('click', function(e) {
          e.stopPropagation();
          
          // Create emoji picker (same as before)
          // ... (omitted for brevity, same as above)
        });
      }
      
      // Toggle reaction
      messageElement.querySelectorAll('.message-reaction-button').forEach(button => {
        button.addEventListener('click', function() {
          const emoji = this.getAttribute('data-emoji');
          
          // Toggle reaction (same as before)
          // ... (omitted for brevity, same as above)
        });
      });
    }
  });
<% end %>
