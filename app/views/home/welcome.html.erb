<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-12 w-auto" src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png" alt="GitHub">
    <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">GitHub Chat</h2>
    <p class="mt-2 text-center text-sm text-gray-600">
      Connect and collaborate with your team in real-time
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
      <div class="space-y-6">
        <div>
          <%= link_to "Sign in with GitHub", "/auth/github", 
              class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-800 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500" %>
        </div>
      </div>

      <div class="mt-6">
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-500">Secure connection</span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="mt-6 text-center text-sm text-gray-600">
      <p>By signing in, you agree to our
        <a href="#" class="font-medium text-gray-900 hover:text-gray-700">Terms of Service</a> and
        <a href="#" class="font-medium text-gray-900 hover:text-gray-700">Privacy Policy</a>.
      </p>
    </div>
  </div>
</div>
